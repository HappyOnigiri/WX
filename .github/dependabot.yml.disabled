# Dependabot automatic pull-request generation is paused during the initial phase.
# Restore this file to .github/dependabot.yml only with explicit user permission.
# 初期フェーズでは Dependabot の自動 PR 作成を停止中。このファイルを
# .github/dependabot.yml に戻すのは、ユーザーの明示許可を得た場合だけにすること。
version: 2
updates:
  - package-ecosystem: gomod
    directory: /
    schedule: { interval: weekly }
    cooldown:
      default-days: 7
  - package-ecosystem: github-actions
    directory: /
    schedule: { interval: weekly }
    cooldown:
      default-days: 7
