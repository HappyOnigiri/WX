# Dependabotの自動PR作成は停止中。
# .github/dependabot.ymlへの復帰にはユーザーの明示許可が必要。
version: 2
updates:
  - package-ecosystem: gomod
    directory: /
    schedule: { interval: weekly }
    cooldown:
      default-days: 7
  - package-ecosystem: github-actions
    directory: /
    schedule: { interval: weekly }
    cooldown:
      default-days: 7
