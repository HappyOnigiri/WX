#!/bin/sh
set -eu

branch=$(git symbolic-ref --quiet --short HEAD 2>/dev/null || true)

if [ "$branch" = "main" ]; then
  echo "Error: main ブランチへの直接コミットは禁止されています。作業ブランチを作成してコミットしてください。" >&2
  exit 1
fi

root=$(git rev-parse --show-toplevel)
# hook-pre-commit はステージ済み差分に応じたfmtと静的検査だけを実行し、テストはGitHub Actionsに任せる。
# FORCE_CI=1 を指定したときだけ `make ci` 全体を実行する。
exec make -C "$root" hook-pre-commit
